# Token do bot, pego com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Seu chat id. Deixe vazio na primeira vez: o bot responde com o número.
# Para liberar mais de uma pessoa, separe por vírgula.
CHATS_PERMITIDOS=

# Opcionais
# MODELO=claude-opus-5-5
# DB_PATH=dados/gastos.db
# FUSO_HORARIO=America/Sao_Paulo

# Servidor de produção, usado só pelo npm run banco:baixar (o bot não lê).
# VM_HOST=usuario@ip-da-vm
# VM_CHAVE=~/.ssh/sua-chave
# Id do app no Coolify (aparece na URL do app e no nome dos containers dele)
# COOLIFY_APP=
